# ============ BOT ============
# BotFather'dan olingan token
BOT_TOKEN=

# ============ DATABASE ============
# Lokal: postgresql+asyncpg://ustaxona:ustaxona@localhost:5432/ustaxona
# Docker: postgresql+asyncpg://ustaxona:ustaxona@db:5432/ustaxona
DATABASE_URL=postgresql+asyncpg://ustaxona:ustaxona@localhost:5432/ustaxona

# Docker Compose uchun Postgres sozlamalari
POSTGRES_USER=ustaxona
POSTGRES_PASSWORD=ustaxona
POSTGRES_DB=ustaxona

# ============ TELEGRAM GURUH ============
# Guruh ID (manfiy son, masalan -1001234567890). Guruhda /groupid buyrug'i bilan oling.
GROUP_ID=

# Forum topic ID'lari. Har bir topic ichida /topicid buyrug'i bilan oling.
PENDING_TOPIC_ID=
READY_TOPIC_ID=
ABOUT_TOPIC_ID=
FAQ_TOPIC_ID=
# E'lonlar bo'limi (sotiladigan texnika, dam olish kunlari) — faqat adminlar yozadi
ELON_TOPIC_ID=

# ============ ADMINLAR ============
# Asosiy adminlarning Telegram ID'lari (vergul bilan): 123456789,987654321
# Bu ID'lar ro'yxatdan o'tishi bilan avtomatik faol ADMIN bo'ladi.
ADMIN_IDS=

# ============ USTAXONA MA'LUMOTLARI ============
WORKSHOP_NAME=KOMPYUTER SERVISI
WORKSHOP_PHONE=+998 90 123 45 67
WORKSHOP_ADDRESS=Toshkent sh., Chilonzor tumani, Bunyodkor ko'chasi 12-uy
WORKSHOP_WORKING_HOURS=09:00 — 20:00

# Telegram lokatsiya uchun koordinatalar (ixtiyoriy, Google Maps'dan oling)
WORKSHOP_LAT=
WORKSHOP_LON=
